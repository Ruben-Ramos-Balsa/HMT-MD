import TPKLifts
import ClosureRegionBridge
import PropagationSemigroup
import AutoscaleBrackets

/-!
Article I, `generacion.tex`: composition of the three structurally selected
regions with their declared readers and rational positional publication.

The finite selectors and reader laws are reused, not replaced by target values.
In particular, `searchDepth` and `publish` inspect rational bounds only.  The
real recognitions occur in correctness theorems after the definitions.

This module does not assert that the X/Y transition records of `TPKLifts` have
been generated by a separately implemented full enriched TPK transition. That
upstream relation remains exactly as declared in the imported module.
-/

noncomputable section
open Filter Topology

namespace HMT.I.RegionalPublicationComposition

inductive Channel where
  | closure | propagation | autoscale
  deriving DecidableEq, Fintype

def candidates : Channel → List TPKOrbits.Word
  | .closure => TPKRegions.orientedClosure
  | .propagation => TPKSimpleRegions.propagationWords
  | .autoscale => TPKSimpleRegions.autoscaleWords

def seed (c : Channel) : TPKOrbits.Word := (candidates c).headD ⟨0,0,0,0,0,0⟩

theorem unique_selected_seed (c : Channel) : candidates c = [seed c] := by
  cases c <;> simp only [candidates, seed, TPKRegions.oriented_closure_checked,
    TPKSimpleRegions.propagation_oriented_checked,
    TPKSimpleRegions.autoscale_oriented_checked, List.headD_cons]

theorem selected_seeds_are_shared :
    [seed .closure, seed .propagation, seed .autoscale] = TPKLifts.selectedSeeds := by
  rw [TPKLifts.selected_seeds_checked]
  simp [seed, candidates, TPKRegions.oriented_closure_checked,
    TPKSimpleRegions.propagation_oriented_checked,
    TPKSimpleRegions.autoscale_oriented_checked]

theorem selected_seed_in_biography (c : Channel) :
    (TPKLifts.expansion 4 (seed c)).take 6 = TPKOrbits.toList (seed c) :=
  TPKLifts.initial_block_preserved (seed c)

/-- The limit is defined from the emitted incidence ratios, not from a radical. -/
def autoscaleValue : ℝ := limUnder atTop AutoscaleLimit.ratio

theorem autoscale_recognition : autoscaleValue = goldenRatio :=
  AutoscaleLimit.ratio_tendsto.limUnder_eq

def value : Channel → ℝ
  | .closure => ClosureRegionBridge.value
  | .propagation => PropagationLimit.value
  | .autoscale => autoscaleValue

def lower : Channel → Nat → ℚ
  | .closure => ClosureAnalytic.lowerQ
  | .propagation => PropagationLimit.partialQ
  | .autoscale => AutoscaleBrackets.lowerQ

def upper : Channel → Nat → ℚ
  | .closure => ClosureAnalytic.upperQ
  | .propagation => PropagationLimit.upperQ
  | .autoscale => AutoscaleBrackets.upperQ

theorem produced_brackets (c : Channel) (k : Nat) :
    (lower c k : ℝ) ≤ value c ∧ value c ≤ (upper c k : ℝ) := by
  cases c with
  | closure => exact ClosureRegionBridge.generated_reader_enclosure k
  | propagation => exact ⟨(PropagationLimit.rational_bracket k).1.le,
      (PropagationLimit.rational_bracket k).2.le⟩
  | autoscale =>
    simpa only [lower, upper, value, autoscale_recognition] using
      And.intro (AutoscaleBrackets.rational_bracket k).1.le
        (AutoscaleBrackets.rational_bracket k).2.le

theorem value_nonnegative (c : Channel) : 0 ≤ value c := by
  cases c with
  | closure =>
    change 0 ≤ ClosureRegionBridge.value
    rw [ClosureRegionBridge.posterior_recognition]
    exact Real.pi_pos.le
  | propagation =>
    change 0 ≤ PropagationLimit.value
    rw [PropagationLimit.value_eq_exp_one]
    exact (Real.exp_pos _).le
  | autoscale =>
    change 0 ≤ autoscaleValue
    rw [autoscale_recognition]
    exact gold_pos.le

theorem value_irrational (c : Channel) : Irrational (value c) := by
  cases c with
  | closure =>
    change Irrational ClosureRegionBridge.value
    rw [ClosureRegionBridge.value_eq_reader]
    exact RadixCellSelection.closure_irrational
  | propagation => exact RadixCellSelection.propagation_irrational
  | autoscale =>
    change Irrational autoscaleValue
    rw [autoscale_recognition]
    exact gold_irrational

theorem eventual_publication (c : Channel) (scale : Nat) (hs : 0 < scale) :
    ∃ N : Nat, ∀ k, N ≤ k →
      RadixCellSelection.first (lower c k) scale = RadixCellSelection.cell (value c) scale ∧
      RadixCellSelection.last (upper c k) scale = RadixCellSelection.cell (value c) scale := by
  cases c with
  | closure => exact ClosureRegionBridge.eventual_cell_publication scale hs
  | propagation => exact RadixCellSelection.propagation_eventual_cell scale hs
  | autoscale =>
    simpa only [lower, upper, value, autoscale_recognition] using
      AutoscaleBrackets.eventual_single_cell scale hs

/-- One finite index suffices for the three correlated regional publications. -/
theorem joint_eventual_publication (scale : Nat) (hs : 0 < scale) :
    ∃ N : Nat, ∀ c k, N ≤ k →
      RadixCellSelection.first (lower c k) scale = RadixCellSelection.cell (value c) scale ∧
      RadixCellSelection.last (upper c k) scale = RadixCellSelection.cell (value c) scale := by
  obtain ⟨a, ha⟩ := eventual_publication .closure scale hs
  obtain ⟨b, hb⟩ := eventual_publication .propagation scale hs
  obtain ⟨d, hd⟩ := eventual_publication .autoscale scale hs
  refine ⟨max a (max b d), ?_⟩
  intro c k hk
  cases c
  · exact ha k (le_trans (le_max_left _ _) hk)
  · exact hb k (le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hk)
  · exact hd k (le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hk)

def Stops (c : Channel) (scale k : Nat) : Prop :=
  RadixCellSelection.first (lower c k) scale = RadixCellSelection.last (upper c k) scale

instance (c : Channel) (scale k : Nat) : Decidable (Stops c scale k) :=
  inferInstanceAs (Decidable (_ = _))

theorem search_terminates (c : Channel) (scale : Nat) (hs : 0 < scale) :
    ∃ k, Stops c scale k := by
  obtain ⟨N, hN⟩ := eventual_publication c scale hs
  exact ⟨N, (hN N le_rfl).1.trans (hN N le_rfl).2.symm⟩

def searchDepth (c : Channel) (scale : Nat) (hs : 0 < scale) : Nat :=
  Nat.find (search_terminates c scale hs)

def publish (c : Channel) (base : Nat) (hb : 0 < base) (depth : Nat) : Nat :=
  (RadixCellSelection.first (lower c (searchDepth c (base^depth) (pow_pos hb depth)))
    (base^depth)).toNat

theorem stopped_cell_correct (c : Channel) (scale k : Nat) (hs : 0 < scale)
    (hk : Stops c scale k) :
    RadixCellSelection.first (lower c k) scale = RadixCellSelection.cell (value c) scale := by
  have hb := produced_brackets c k
  have hsR : (0 : ℝ) ≤ scale := Nat.cast_nonneg _
  have hlo : RadixCellSelection.first (lower c k) scale ≤
      RadixCellSelection.cell (value c) scale := by
    rw [RadixCellSelection.first_real]
    exact Int.floor_mono (mul_le_mul_of_nonneg_right hb.1 hsR)
  have havoid := RadixCellSelection.irrational_avoids_boundary (value_irrational c) scale hs
  have hstrict := RadixCellSelection.cell_strict_lower (value c) scale havoid
  have hu : (RadixCellSelection.cell (value c) scale : ℝ) < (upper c k : ℝ) * scale :=
    hstrict.trans_le (mul_le_mul_of_nonneg_right hb.2 hsR)
  have huInt : RadixCellSelection.cell (value c) scale < ⌈(upper c k : ℝ) * scale⌉ :=
    Int.lt_ceil.mpr hu
  change RadixCellSelection.first (lower c k) scale = RadixCellSelection.last (upper c k) scale at hk
  rw [RadixCellSelection.last_real] at hk
  omega

theorem publish_eq_prefix (c : Channel) (base : Nat) (hb : 0 < base) (depth : Nat) :
    publish c base hb depth = RadixCellSelection.positionalPrefix (value c) base depth := by
  unfold publish searchDepth
  rw [stopped_cell_correct c (base^depth) _ (pow_pos hb depth)
    (Nat.find_spec (search_terminates c (base^depth) (pow_pos hb depth)))]
  rw [← RadixCellSelection.prefix_as_cell _ (value_nonnegative c)]
  exact Int.toNat_natCast _

/-- The computed publications, not only the real limits, commute with truncation. -/
theorem publications_compatible (c : Channel) (base : Nat) (hb : 0 < base) (n m : Nat) :
    publish c base hb (n+m) / base^m = publish c base hb n := by
  simp only [publish_eq_prefix]
  exact RadixCellSelection.prefix_truncate _ base n m hb

theorem publication_step (c : Channel) (base : Nat) (hb : 0 < base) (n : Nat) :
    publish c base hb (n+1) =
      base * publish c base hb n + publish c base hb (n+1) % base := by
  have h := publications_compatible c base hb n 1
  simp only [pow_one] at h
  exact (Nat.div_add_mod (publish c base hb (n+1)) base).symm.trans (by rw [h])

/-- Posterior recognition, after regional selection, reader construction, and search. -/
theorem recognized_publications (base : Nat) (hb : 0 < base) (n : Nat) :
    publish .closure base hb n = RadixCellSelection.positionalPrefix Real.pi base n ∧
    publish .propagation base hb n = RadixCellSelection.positionalPrefix (Real.exp 1) base n ∧
    publish .autoscale base hb n = RadixCellSelection.positionalPrefix goldenRatio base n := by
  simp only [publish_eq_prefix, value, ClosureRegionBridge.posterior_recognition,
    PropagationLimit.value_eq_exp_one, autoscale_recognition, and_self]

end HMT.I.RegionalPublicationComposition
end

