{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmt.example/schemas/ch-release-manifest-v1.json",
  "title": "HMT CH autonomous release manifest",
  "type": "object",
  "required": ["schema", "files"],
  "properties": {
    "schema": {
      "const": "HMT.CH.release-manifest.v1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "required_for": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
