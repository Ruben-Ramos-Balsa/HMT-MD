theorem rows_checked : rows = rowWitness := by
  rw [rows, plus_metadata_checked, times_metadata_checked]
  decide +kernel

theorem rows_emit_exactly :
    rows.map RegionalRow.emission = TPKOrbits.emissionWords := by
  rw [rows_checked, TPKOrbits.emission_witness_checked]
  decide +kernel

theorem rows_count : rows.length = 468 := by rw [rows_checked]; decide +kernel
theorem rows_emissions_nodup : (rows.map RegionalRow.emission).Nodup := by
  rw [rows_checked]
  decide +kernel

theorem total_seed_mass : (rows.map RegionalRow.multiplicity).foldl Nat.add 0 = 104976 := by
  rw [rows_checked]
  decide +kernel

theorem metadata_valid : ∀ r ∈ rows, r.diagonal < 9 ∧
    (r.heading = .no ∨ r.heading = .es) := by
  rw [rows_checked]
  decide +kernel

def fibre (w : TPKOrbits.Word) : List RegionalRow :=
  rows.filter (fun row => TPKOrbits.psi row.emission == w)
def seedMass (w : TPKOrbits.Word) : Nat := (fibre w).foldl (fun n r => n + r.multiplicity) 0

/-- Structural insertion sort keeps the finite certificate kernel-reducible. -/
def insertMass (a : Nat) : List Nat → List Nat
  | [] => [a]
  | b :: bs => if a ≤ b then a :: b :: bs else b :: insertMass a bs
def sortMasses : List Nat → List Nat
  | [] => []
  | a :: as => insertMass a (sortMasses as)

theorem insertMass_perm (a : Nat) (xs : List Nat) :
    (insertMass a xs).Perm (a :: xs) := by
  induction xs with
  | nil => exact List.Perm.refl _
  | cons b bs ih =>
    by_cases h : a ≤ b
    · simp only [insertMass, if_pos h]
      exact List.Perm.refl _
    · simp only [insertMass, if_neg h]
      exact (List.Perm.cons b ih).trans (List.Perm.swap a b bs)

theorem sortMasses_perm (xs : List Nat) : (sortMasses xs).Perm xs := by
  induction xs with
  | nil => exact List.Perm.refl _
  | cons a as ih =>
    exact (insertMass_perm a (sortMasses as)).trans (List.Perm.cons a ih)

def sortedMasses (w : TPKOrbits.Word) : List Nat :=
  sortMasses ((fibre w).map RegionalRow.multiplicity)

def isClosure (r : TPKOrbits.Word) : Bool :=
  (TPKOrbits.orbit r).length == 6 &&
    (TPKOrbits.orbit r).all (fun w =>
      (fibre w).length == 5 && seedMass w == 1008 &&
        sortedMasses w == [144, 144, 144, 144, 432])

def closureOrbits : List TPKOrbits.Word := TPKOrbits.representatives.filter isClosure

theorem closure_orbit_checked : closureOrbits = [⟨0, 0, 1, 1, 1, 2⟩] := by
  unfold closureOrbits isClosure seedMass sortedMasses fibre
  simp only [TPKOrbits.representatives_checked, rows_checked]
  decide +kernel

theorem closure_orbit_unique : closureOrbits.length = 1 := by
  rw [closure_orbit_checked]
  decide +kernel

def hasOrientation (w : TPKOrbits.Word) : Bool :=
  (fibre w).any (fun r => r.diagonal == 6 && r.heading == .es)
def orientedClosure : List TPKOrbits.Word :=
  closureOrbits.flatMap (fun r => (TPKOrbits.orbit r).filter hasOrientation)

theorem oriented_closure_checked : orientedClosure = [⟨0, 1, 0, 2, 1, 1⟩] := by
  unfold orientedClosure hasOrientation fibre
  simp only [closure_orbit_checked, rows_checked]
  decide +kernel

theorem orientation_unique : orientedClosure.length = 1 := by
  rw [oriented_closure_checked]
  decide +kernel

def closureFibre : List RegionalRow := orientedClosure.flatMap fibre

def closureFibreWitness : List RegionalRow := [
  ⟨⟨501, 614, 498, 169, 272, 272⟩, 432, 4, .no, [5, 5, 5, 5, 5, 5]⟩,
  ⟨⟨870, 923, 810, 418, 674, 521⟩, 144, 5, .no, [9, 3, 3, 7, 1, 7]⟩,
  ⟨⟨810, 923, 870, 169, 272, 272⟩, 144, 6, .es, [3, 3, 9, 5, 5, 5]⟩,
  ⟨⟨870, 923, 810, 169, 272, 272⟩, 144, 6, .es, [9, 3, 3, 5, 5, 5]⟩,
  ⟨⟨810, 983, 810, 169, 272, 272⟩, 144, 6, .es, [3, 9, 3, 5, 5, 5]⟩
]

theorem closure_fibre_checked : closureFibre = closureFibreWitness := by
  unfold closureFibre fibre
  simp only [oriented_closure_checked, rows_checked]
  decide +kernel

theorem closure_five_regions : closureFibre.length = 5 := by
  rw [closure_fibre_checked]
  decide +kernel

def anchors : List RegionalRow := closureFibre.filter (fun r => r.multiplicity == 432)
def companions : List RegionalRow := closureFibre.filter (fun r => r.multiplicity == 144)

theorem closure_one_anchor : anchors.length = 1 := by
  rw [anchors, closure_fibre_checked]
  decide +kernel

theorem closure_four_companions : companions.length = 4 := by
  rw [companions, closure_fibre_checked]
  decide +kernel

theorem closure_mass : (closureFibre.map RegionalRow.multiplicity).foldl Nat.add 0 = 1008 := by
  rw [closure_fibre_checked]
  decide +kernel

theorem closure_mass_partition :
    ∀ r ∈ closureFibre, r.multiplicity = 432 ∨ r.multiplicity = 144 := by
  rw [closure_fibre_checked]
  decide +kernel

theorem anchor_companion_disjoint :
    ∀ r ∈ anchors, r ∉ companions := by
  rw [anchors, companions, closure_fibre_checked]
  decide +kernel

theorem closure_reader_arities :
    (closureFibre.length, anchors.length, companions.length) = (5, 1, 4) := by
  rw [closure_five_regions, closure_one_anchor, closure_four_companions]

