import TPKOrbits

/-!
Metadata and closure selection from the generated finite emitter.
The preimage fibres, diagonal and direction sets precede the regional
selection. Literal tables are checked output witnesses, never input catalogues.
-/
namespace TPKRegions
open TPKTransport TPKFiniteCursor
set_option maxRecDepth 1000000
set_option maxHeartbeats 0

def preimages (sheet : Sheet) (sig : List Nat) : List FiniteCursor :=
  ((TPKCensus.seeds.zip (TPKCensus.signatures sheet)).filter
    (fun p => p.2 == sig)).map Prod.fst

theorem paired_signatures (sheet : Sheet) :
    TPKCensus.seeds.zip (TPKCensus.signatures sheet) =
      TPKCensus.seeds.map (fun c => (c, signatureFast sheet c)) := by
  simpa only [TPKCensus.signatures, List.map_id] using
    (List.zip_map' (l := TPKCensus.seeds) (f := id) (g := signatureFast sheet))

theorem preimages_exact (sheet : Sheet) (sig : List Nat) :
    preimages sheet sig =
      TPKCensus.seeds.filter (fun c => signatureFast sheet c == sig) := by
  rw [preimages, paired_signatures, List.filter_map, List.map_map]
  simp only [Function.comp_def]
  exact List.map_id _

theorem preimage_membership (sheet : Sheet) (sig : List Nat) (c : FiniteCursor) :
    c ∈ preimages sheet sig ↔ signature sheet c = sig := by
  rw [preimages_exact]
  simp only [List.mem_filter, TPKCensus.seeds_complete, true_and,
    beq_iff_eq, signatureFast_eq]

theorem preimage_cardinality (sheet : Sheet) (sig : List Nat) :
    (preimages sheet sig).length = TPKCensus.multiplicity sheet sig := by
  rw [preimages_exact]
  simp only [TPKCensus.multiplicity, TPKCensus.signatures, List.filter_map, List.length_map]
  rfl

def pairedPreimages (s e : List Nat) : List (FiniteCursor × FiniteCursor) :=
  (preimages .additive s).flatMap (fun p => (preimages .multiplicative e).map (p, ·))

theorem product_list_length {α β : Type} (xs : List α) (ys : List β) :
    (xs.flatMap (fun x => ys.map (x, ·))).length = xs.length * ys.length := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [List.flatMap_cons, ih, Nat.succ_mul, Nat.add_comm]

theorem seed_multiplicity_product (s e : List Nat) :
    (pairedPreimages s e).length =
      (preimages .additive s).length * (preimages .multiplicative e).length :=
  product_list_length _ _

theorem paired_preimage_membership (s e : List Nat) (p t : FiniteCursor) :
    (p, t) ∈ pairedPreimages s e ↔
      signature .additive p = s ∧ signature .multiplicative t = e := by
  simp [pairedPreimages, List.mem_flatMap, List.mem_map, preimage_membership]

def diagonal (c : FiniteCursor) : Nat := (c.x.val + c.y.val) % 9
def diagonals (sig : List Nat) : List Nat :=
  ((preimages .additive sig).map diagonal).eraseDups
def headings (sig : List Nat) : List Direction :=
  TPKCensus.directions.filter (fun d =>
    ((preimages .additive sig).map FiniteCursor.direction).contains d)

structure PlusMetadata where
  signature : List Nat
  count : Nat
  diagonals : List Nat
  headings : List Direction
  deriving DecidableEq, Repr

structure TimesMetadata where
  signature : List Nat
  count : Nat
  deriving DecidableEq, Repr

def plusMetadata (s : List Nat) : PlusMetadata :=
  ⟨s, (preimages .additive s).length, diagonals s, headings s⟩
def timesMetadata (e : List Nat) : TimesMetadata :=
  ⟨e, (preimages .multiplicative e).length⟩
def plusClasses : List PlusMetadata := (TPKCensus.signatureImage .additive).map plusMetadata
def timesClasses : List TimesMetadata := (TPKCensus.signatureImage .multiplicative).map timesMetadata

