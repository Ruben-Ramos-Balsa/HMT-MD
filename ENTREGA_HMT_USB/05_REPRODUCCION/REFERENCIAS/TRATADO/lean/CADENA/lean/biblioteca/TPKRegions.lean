theorem plus_metadata_checked : plusClasses = plusWitness := by
  simp only [plusClasses, plusMetadata, diagonals, headings, preimages,
    TPKCensus.signatureImage, TPKCensus.signatures_additive_checked]
  decide +kernel

theorem times_metadata_checked : timesClasses = timesWitness := by
  simp only [timesClasses, timesMetadata, preimages,
    TPKCensus.signatureImage, TPKCensus.signatures_multiplicative_checked]
  decide +kernel

theorem plus_metadata_complete (s : List Nat) :
    s ∈ TPKCensus.signatureImage .additive → plusMetadata s ∈ plusClasses := by
  intro h
  exact List.mem_map.mpr ⟨s, h, rfl⟩

theorem additive_metadata_valid :
    ∀ p ∈ plusClasses, p.count = 18 ∧ p.diagonals.length = 1 ∧
      (p.headings = [.north, .west] ∨ p.headings = [.east, .south]) := by
  rw [plus_metadata_checked]
  decide +kernel

theorem additive_diagonal_unique (s : List Nat)
    (hs : s ∈ TPKCensus.signatureImage .additive) :
    (diagonals s).length = 1 :=
  (additive_metadata_valid (plusMetadata s) (plus_metadata_complete s hs)).2.1

theorem additive_heading_classes (s : List Nat)
    (hs : s ∈ TPKCensus.signatureImage .additive) :
    headings s = [.north, .west] ∨ headings s = [.east, .south] :=
  (additive_metadata_valid (plusMetadata s) (plus_metadata_complete s hs)).2.2

inductive HeadingClass where
  | no | es | invalid
  deriving DecidableEq, Repr

def headingClass (ds : List Direction) : HeadingClass :=
  if ds == [.north, .west] then .no
  else if ds == [.east, .south] then .es else .invalid

structure RegionalRow where
  emission : TPKOrbits.Word
  multiplicity : Nat
  diagonal : Nat
  heading : HeadingClass
  multiplicativeSignature : List Nat
  deriving DecidableEq, Repr

def makeRow (p : PlusMetadata) (t : TimesMetadata) : RegionalRow :=
  ⟨TPKOrbits.ofList (TPKCensus.couple p.signature t.signature),
    p.count * t.count, p.diagonals.headD 0, headingClass p.headings, t.signature⟩

theorem row_multiplicity_is_seed_count (s e : List Nat) :
    (makeRow (plusMetadata s) (timesMetadata e)).multiplicity =
      (pairedPreimages s e).length := (seed_multiplicity_product s e).symm

def rows : List RegionalRow := plusClasses.flatMap (fun p => timesClasses.map (makeRow p))

theorem row_source_factorization {r : RegionalRow} (hr : r ∈ rows) :
    ∃ s ∈ TPKCensus.signatureImage .additive,
      ∃ e ∈ TPKCensus.signatureImage .multiplicative,
        makeRow (plusMetadata s) (timesMetadata e) = r := by
  simp only [rows, plusClasses, timesClasses, List.mem_flatMap, List.mem_map] at hr
  rcases hr with ⟨p, ⟨s, hs, hp⟩, t, ⟨e, he, ht⟩, hr⟩
  exact ⟨s, hs, e, he, by rw [hp, ht]; exact hr⟩

