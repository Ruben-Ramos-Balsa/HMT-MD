import ArticleIIIFromSharedBase

/-!
Article III, iii:eq:dimensions: transport of the already constructed normalized
response to arbitrary positive action, charge and velocity unit sections.

This is a dimensional chart. The sections are explicit choices, not outputs
claimed to be generated by the normalized constitutive construction. No SI or
metrological value is fixed. The underlying selected HMT register, angles and
channels are exactly those imported from ArticleIIIFromSharedBase.

The formulas are recovered from the existing manuscript; the scalar chart
interface and its reversibility/covariance proofs are added here. This module
does not change the assumptions or scope of the upstream constitutive proof.
-/

noncomputable section
namespace HMT.Shared.ArticleIII.Dimensional

structure PosUnitSections where
  action : ℝ
  charge : ℝ
  velocity : ℝ
  action_pos : 0 < action
  charge_pos : 0 < charge
  velocity_pos : 0 < velocity

namespace PosUnitSections

theorem action_ne_zero (u : PosUnitSections) : u.action ≠ 0 := ne_of_gt u.action_pos
theorem charge_ne_zero (u : PosUnitSections) : u.charge ≠ 0 := ne_of_gt u.charge_pos
theorem velocity_ne_zero (u : PosUnitSections) : u.velocity ≠ 0 := ne_of_gt u.velocity_pos

/-- The second triple supplies three arbitrary positive rescaling factors. -/
def rescale (u k : PosUnitSections) : PosUnitSections where
  action := u.action * k.action
  charge := u.charge * k.charge
  velocity := u.velocity * k.velocity
  action_pos := mul_pos u.action_pos k.action_pos
  charge_pos := mul_pos u.charge_pos k.charge_pos
  velocity_pos := mul_pos u.velocity_pos k.velocity_pos

end PosUnitSections

@[ext] structure Reading where
  epsilon : ℝ
  mu : ℝ
  impedance : ℝ
  speed : ℝ

namespace Reading

def Positive (w : Reading) : Prop :=
  0 < w.epsilon ∧ 0 < w.mu ∧ 0 < w.impedance ∧ 0 < w.speed

def Constitutive (w : Reading) : Prop :=
  w.mu * w.epsilon = 1 / w.speed ^ 2 ∧ w.mu / w.epsilon = w.impedance ^ 2

end Reading

def normalized : Reading where
  epsilon := HMT.Shared.ArticleIII.epsilon
  mu := HMT.Shared.ArticleIII.mu
  impedance := HMT.Shared.ArticleIII.impedance
  speed := HMT.Shared.ArticleIII.speed

def toDimensional (u : PosUnitSections) (w : Reading) : Reading where
  epsilon := w.epsilon * u.charge ^ 2 / (u.action * u.velocity)
  mu := w.mu * u.action / (u.velocity * u.charge ^ 2)
  impedance := w.impedance * u.action / u.charge ^ 2
  speed := w.speed * u.velocity

def toNormalized (u : PosUnitSections) (w : Reading) : Reading where
  epsilon := w.epsilon * (u.action * u.velocity) / u.charge ^ 2
  mu := w.mu * (u.velocity * u.charge ^ 2) / u.action
  impedance := w.impedance * u.charge ^ 2 / u.action
  speed := w.speed / u.velocity

def selected (u : PosUnitSections) : Reading := toDimensional u normalized

theorem normalized_positive : normalized.Positive :=
  HMT.Shared.ArticleIII.coordinates_positive

theorem normalized_constitutive : normalized.Constitutive :=
  ⟨HMT.Shared.ArticleIII.constitutive_identities.1,
    HMT.Shared.ArticleIII.constitutive_identities.2.1⟩

theorem toDimensional_positive (u : PosUnitSections) (w : Reading) (hw : w.Positive) :
    (toDimensional u w).Positive := by
  rcases hw with ⟨he, hm, hZ, hc⟩
  have hS := u.action_pos
  have hQ := u.charge_pos
  have hC := u.velocity_pos
  dsimp [Reading.Positive, toDimensional]
  exact ⟨div_pos (mul_pos he (sq_pos_of_pos hQ)) (mul_pos hS hC),
    div_pos (mul_pos hm hS) (mul_pos hC (sq_pos_of_pos hQ)),
    div_pos (mul_pos hZ hS) (sq_pos_of_pos hQ), mul_pos hc hC⟩

theorem toNormalized_positive (u : PosUnitSections) (w : Reading) (hw : w.Positive) :
    (toNormalized u w).Positive := by
  rcases hw with ⟨he, hm, hZ, hc⟩
  have hS := u.action_pos
  have hQ := u.charge_pos
  have hC := u.velocity_pos
  dsimp [Reading.Positive, toNormalized]
  exact ⟨div_pos (mul_pos he (mul_pos hS hC)) (sq_pos_of_pos hQ),
    div_pos (mul_pos hm (mul_pos hC (sq_pos_of_pos hQ))) hS,
    div_pos (mul_pos hZ (sq_pos_of_pos hQ)) hS, div_pos hc hC⟩

/-- Undoing the unit sections recovers every labelled normalized coordinate. -/
theorem normalized_after_dimensional (u : PosUnitSections) (w : Reading) :
    toNormalized u (toDimensional u w) = w := by
  ext <;> dsimp [toNormalized, toDimensional] <;>
    field_simp [u.action_ne_zero, u.charge_ne_zero, u.velocity_ne_zero]

/-- The inverse chart is also a right inverse; no reading is discarded. -/
theorem dimensional_after_normalized (u : PosUnitSections) (w : Reading) :
    toDimensional u (toNormalized u w) = w := by
  ext <;> dsimp [toNormalized, toDimensional] <;>
    field_simp [u.action_ne_zero, u.charge_ne_zero, u.velocity_ne_zero]

theorem toDimensional_constitutive (u : PosUnitSections) (w : Reading)
    (hw : w.Positive) (hc : w.Constitutive) :
    (toDimensional u w).Constitutive := by
  have he : w.epsilon ≠ 0 := ne_of_gt hw.1
  constructor
  · change (w.mu * u.action / (u.velocity * u.charge ^ 2)) *
        (w.epsilon * u.charge ^ 2 / (u.action * u.velocity)) =
      1 / (w.speed * u.velocity) ^ 2
    calc
      _ = (w.mu * w.epsilon) / u.velocity ^ 2 := by
        field_simp [u.action_ne_zero, u.charge_ne_zero, u.velocity_ne_zero]
        ring
      _ = (1 / w.speed ^ 2) / u.velocity ^ 2 := by rw [hc.1]
      _ = 1 / (w.speed * u.velocity) ^ 2 := by rw [div_div, mul_pow]
  · change (w.mu * u.action / (u.velocity * u.charge ^ 2)) /
        (w.epsilon * u.charge ^ 2 / (u.action * u.velocity)) =
      (w.impedance * u.action / u.charge ^ 2) ^ 2
    calc
      _ = (w.mu / w.epsilon) * (u.action / u.charge ^ 2) ^ 2 := by
        field_simp [he, u.action_ne_zero, u.charge_ne_zero, u.velocity_ne_zero]
        ring
      _ = w.impedance ^ 2 * (u.action / u.charge ^ 2) ^ 2 := by rw [hc.2]
      _ = (w.impedance * u.action / u.charge ^ 2) ^ 2 := by ring

theorem selected_positive (u : PosUnitSections) : (selected u).Positive :=
  toDimensional_positive u normalized normalized_positive

theorem selected_constitutive (u : PosUnitSections) :
    (selected u).mu * (selected u).epsilon = 1 / (selected u).speed ^ 2 ∧
    (selected u).mu / (selected u).epsilon = (selected u).impedance ^ 2 :=
  toDimensional_constitutive u normalized normalized_positive normalized_constitutive

theorem selected_chart_recovery (u : PosUnitSections) :
    toNormalized u (selected u) = normalized :=
  normalized_after_dimensional u normalized

/-- Covariance uses independent positive changes of the three unit sections. -/
theorem dimensional_covariance (u k : PosUnitSections) (w : Reading) :
    (toDimensional (u.rescale k) w).epsilon =
      (toDimensional u w).epsilon * k.charge ^ 2 / (k.action * k.velocity) ∧
    (toDimensional (u.rescale k) w).mu =
      (toDimensional u w).mu * k.action / (k.velocity * k.charge ^ 2) ∧
    (toDimensional (u.rescale k) w).impedance =
      (toDimensional u w).impedance * k.action / k.charge ^ 2 ∧
    (toDimensional (u.rescale k) w).speed = (toDimensional u w).speed * k.velocity := by
  dsimp [toDimensional, PosUnitSections.rescale]
  constructor
  · field_simp
    ring
  constructor
  · field_simp
    ring
  constructor
  · field_simp
    ring
  · ring

def rechart (u v : PosUnitSections) (w : Reading) : Reading :=
  toDimensional v (toNormalized u w)

theorem rechart_selected (u v : PosUnitSections) :
    rechart u v (selected u) = selected v := by
  rw [rechart, selected_chart_recovery]
  rfl

theorem rechart_reversible (u v : PosUnitSections) (w : Reading) :
    rechart v u (rechart u v w) = w := by
  unfold rechart
  rw [normalized_after_dimensional, dimensional_after_normalized]

/-- Dimensional publication preserves the constitutive laws and the exact inverse. -/
theorem selected_dimensional_publication (u : PosUnitSections) :
    (selected u).Positive ∧
    ((selected u).mu * (selected u).epsilon = 1 / (selected u).speed ^ 2 ∧
      (selected u).mu / (selected u).epsilon = (selected u).impedance ^ 2) ∧
    toNormalized u (selected u) = normalized :=
  ⟨selected_positive u, selected_constitutive u, selected_chart_recovery u⟩

end HMT.Shared.ArticleIII.Dimensional
end

