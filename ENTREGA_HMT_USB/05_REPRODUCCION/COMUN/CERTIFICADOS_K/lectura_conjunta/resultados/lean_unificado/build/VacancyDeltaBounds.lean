import AlphaStateLinkBound

/-!
# Generated vacancy coordinate and certified logarithmic enclosure

The vacancy coordinate is generated by the nonadic/decimal completion scales:

* `729 = 3^6` and `1000 = 10^3`;
* `rho = log_1000 729 = log_10 9`;
* `delta = 1 - rho = log_10 (10/9)`.

No value of alpha, no metrological table, and no target root enters this
definition.  The analytic enclosures below are obtained from the real-logarithm
series with explicit rational remainders.  The final theorem discharges exactly
the vacancy interval consumed by `AlphaStateLinkBound.stateLink_abs_le`.
-/

noncomputable section

namespace VacancyDeltaBounds

open Finset

def logRatioPartial (y : ℝ) (n : ℕ) : ℝ :=
  (∑ i ∈ range n, y ^ (i + 1) / (i + 1)) -
    (∑ i ∈ range n, (-y) ^ (i + 1) / (i + 1))

def logRatioError (y : ℝ) (n : ℕ) : ℝ :=
  2 * y ^ (n + 1) / (1 - y)

theorem logRatio_enclosure (y : ℝ) (n : ℕ) (hy0 : 0 ≤ y) (hy1 : y < 1) :
    logRatioPartial y n - logRatioError y n ≤
        Real.log (1 + y) - Real.log (1 - y) ∧
      Real.log (1 + y) - Real.log (1 - y) ≤
        logRatioPartial y n + logRatioError y n := by
  have habs : |y| < 1 := by simpa [abs_of_nonneg hy0]
  have hpos := Real.abs_log_sub_add_sum_range_le habs n
  have hneg := Real.abs_log_sub_add_sum_range_le (x := -y) (by simpa [abs_of_nonneg hy0]) n
  simp only [abs_neg, abs_of_nonneg hy0] at hpos hneg
  rw [abs_le] at hpos hneg
  have hneg' :
      -(y ^ (n + 1) / (1 - y)) ≤
          (∑ i ∈ range n, (-y) ^ (i + 1) / (i + 1)) + Real.log (1 + y) ∧
        (∑ i ∈ range n, (-y) ^ (i + 1) / (i + 1)) + Real.log (1 + y) ≤
          y ^ (n + 1) / (1 - y) := by
    simpa only [sub_neg_eq_add] using hneg
  dsimp [logRatioPartial, logRatioError]
  have hpL :
      -(y ^ (n + 1) / (1 - y)) -
          (∑ i ∈ range n, y ^ (i + 1) / (i + 1)) ≤ Real.log (1 - y) := by
    linarith [hpos.1]
  have hpU :
      Real.log (1 - y) ≤ y ^ (n + 1) / (1 - y) -
          (∑ i ∈ range n, y ^ (i + 1) / (i + 1)) := by
    linarith [hpos.2]
  have hnL :
      -(y ^ (n + 1) / (1 - y)) -
          (∑ i ∈ range n, (-y) ^ (i + 1) / (i + 1)) ≤ Real.log (1 + y) := by
    linarith [hneg'.1]
  have hnU :
      Real.log (1 + y) ≤ y ^ (n + 1) / (1 - y) -
          (∑ i ∈ range n, (-y) ^ (i + 1) / (i + 1)) := by
    linarith [hneg'.2]
  constructor
  · calc
      (∑ i ∈ range n, y ^ (i + 1) / (i + 1)) -
            (∑ i ∈ range n, (-y) ^ (i + 1) / (i + 1)) -
            2 * y ^ (n + 1) / (1 - y) =
          (-(y ^ (n + 1) / (1 - y)) -
              (∑ i ∈ range n, (-y) ^ (i + 1) / (i + 1))) -
            (y ^ (n + 1) / (1 - y) -
              (∑ i ∈ range n, y ^ (i + 1) / (i + 1))) := by ring
      _ ≤ Real.log (1 + y) - Real.log (1 - y) := sub_le_sub hnL hpU
  · calc
      Real.log (1 + y) - Real.log (1 - y) ≤
          (y ^ (n + 1) / (1 - y) -
              (∑ i ∈ range n, (-y) ^ (i + 1) / (i + 1))) -
            (-(y ^ (n + 1) / (1 - y)) -
              (∑ i ∈ range n, y ^ (i + 1) / (i + 1))) := sub_le_sub hnU hpL
      _ = (∑ i ∈ range n, y ^ (i + 1) / (i + 1)) -
            (∑ i ∈ range n, (-y) ^ (i + 1) / (i + 1)) +
            2 * y ^ (n + 1) / (1 - y) := by ring

def numeratorLower : ℝ :=
  105360515657826301227500980839312798306120 / (10 : ℝ)^42

def numeratorUpper : ℝ :=
  105360515657826301227500980839312798306121 / (10 : ℝ)^42

def threeLower : ℝ :=
  1098612288668109691395245236922525704647490 / (10 : ℝ)^42

def threeUpper : ℝ :=
  1098612288668109691395245236922525704647491 / (10 : ℝ)^42

theorem log_ten_ninth_eq_ratio :
    Real.log (10 / 9 : ℝ) =
      Real.log (1 + (1 / 19 : ℝ)) - Real.log (1 - (1 / 19 : ℝ)) := by
  calc
    Real.log (10 / 9 : ℝ) =
        Real.log ((1 + (1 / 19 : ℝ)) / (1 - (1 / 19 : ℝ))) := by norm_num
    _ = Real.log (1 + (1 / 19 : ℝ)) - Real.log (1 - (1 / 19 : ℝ)) := by
      rw [Real.log_div] <;> norm_num

theorem log_three_eq_ratio :
    Real.log (3 : ℝ) =
      Real.log (1 + (1 / 2 : ℝ)) - Real.log (1 - (1 / 2 : ℝ)) := by
  calc
    Real.log (3 : ℝ) =
        Real.log ((1 + (1 / 2 : ℝ)) / (1 - (1 / 2 : ℝ))) := by norm_num
    _ = Real.log (1 + (1 / 2 : ℝ)) - Real.log (1 - (1 / 2 : ℝ)) := by
      rw [Real.log_div] <;> norm_num

theorem log_ten_ninth_enclosure :
    numeratorLower < Real.log (10 / 9 : ℝ) ∧
      Real.log (10 / 9 : ℝ) < numeratorUpper := by
  have h := logRatio_enclosure (1 / 19 : ℝ) 40 (by norm_num) (by norm_num)
  rw [← log_ten_ninth_eq_ratio] at h
  norm_num [logRatioPartial, logRatioError, numeratorLower, numeratorUpper,
    Finset.sum_range_succ] at h ⊢
  constructor <;> linarith

theorem log_three_enclosure :
    threeLower < Real.log (3 : ℝ) ∧ Real.log (3 : ℝ) < threeUpper := by
  have h := logRatio_enclosure (1 / 2 : ℝ) 150 (by norm_num) (by norm_num)
  rw [← log_three_eq_ratio] at h
  norm_num [logRatioPartial, logRatioError, threeLower, threeUpper,
    Finset.sum_range_succ] at h ⊢
  constructor <;> linarith

def vacancyDelta : ℝ := Real.log (10 / 9 : ℝ) / Real.log (10 : ℝ)

def completionDensity : ℝ := Real.log (729 : ℝ) / Real.log (1000 : ℝ)

theorem log_ten_decomposition :
    Real.log (10 : ℝ) = Real.log (10 / 9 : ℝ) + 2 * Real.log (3 : ℝ) := by
  calc
    Real.log (10 : ℝ) = Real.log ((10 / 9 : ℝ) * (3 * 3)) := by norm_num
    _ = Real.log (10 / 9 : ℝ) + Real.log ((3 : ℝ) * 3) := by
      rw [Real.log_mul] <;> norm_num
    _ = Real.log (10 / 9 : ℝ) + 2 * Real.log (3 : ℝ) := by
      rw [Real.log_mul] <;> norm_num
      ring

theorem vacancyDelta_eq_one_sub_completionDensity :
    vacancyDelta = 1 - completionDensity := by
  have h729 : Real.log (729 : ℝ) = 6 * Real.log (3 : ℝ) := by
    rw [show (729 : ℝ) = (3 : ℝ)^6 by norm_num, Real.log_pow]
    norm_num
  have h1000 : Real.log (1000 : ℝ) = 3 * Real.log (10 : ℝ) := by
    rw [show (1000 : ℝ) = (10 : ℝ)^3 by norm_num, Real.log_pow]
    norm_num
  have hnum :
      Real.log (10 / 9 : ℝ) = Real.log (10 : ℝ) - 2 * Real.log (3 : ℝ) := by
    linarith [log_ten_decomposition]
  have hlog10 : Real.log (10 : ℝ) ≠ 0 :=
    ne_of_gt (Real.log_pos (by norm_num))
  rw [vacancyDelta, completionDensity, h729, h1000, hnum]
  field_simp [hlog10]
  ring

theorem vacancyDelta_enclosure :
    AlphaStateLinkBound.deltaLower < vacancyDelta ∧
      vacancyDelta < AlphaStateLinkBound.deltaUpper := by
  have hn := log_ten_ninth_enclosure
  have ht := log_three_enclosure
  have hn0 : 0 < Real.log (10 / 9 : ℝ) := by
    have h : 0 < numeratorLower := by norm_num [numeratorLower]
    linarith [hn.1]
  have hnLower0 : 0 < numeratorLower := by norm_num [numeratorLower]
  have hnUpper0 : 0 < numeratorUpper := by norm_num [numeratorUpper]
  have htLower0 : 0 < threeLower := by norm_num [threeLower]
  have hdenActual : 0 < Real.log (10 / 9 : ℝ) + 2 * Real.log (3 : ℝ) := by
    linarith [hn.1, ht.1]
  have hdenLower : 0 < numeratorLower + 2 * threeLower := by linarith
  have hdenUpper : 0 < numeratorUpper + 2 * threeUpper := by
    have htUpper0 : 0 < threeUpper := by norm_num [threeUpper]
    linarith
  have hdenLtUpper :
      Real.log (10 / 9 : ℝ) + 2 * Real.log (3 : ℝ) <
        numeratorUpper + 2 * threeUpper := by linarith [hn.2, ht.2]
  have hdenLowerLt :
      numeratorLower + 2 * threeLower <
        Real.log (10 / 9 : ℝ) + 2 * Real.log (3 : ℝ) := by
    linarith [hn.1, ht.1]
  have hratioLower :
      numeratorLower / (numeratorUpper + 2 * threeUpper) <
        Real.log (10 / 9 : ℝ) /
          (Real.log (10 / 9 : ℝ) + 2 * Real.log (3 : ℝ)) := by
    calc
      numeratorLower / (numeratorUpper + 2 * threeUpper) <
          Real.log (10 / 9 : ℝ) / (numeratorUpper + 2 * threeUpper) :=
        (div_lt_div_iff_of_pos_right hdenUpper).2 hn.1
      _ < Real.log (10 / 9 : ℝ) /
          (Real.log (10 / 9 : ℝ) + 2 * Real.log (3 : ℝ)) := by
        apply (div_lt_div_iff₀ hdenUpper hdenActual).2
        nlinarith
  have hratioUpper :
      Real.log (10 / 9 : ℝ) /
          (Real.log (10 / 9 : ℝ) + 2 * Real.log (3 : ℝ)) <
        numeratorUpper / (numeratorLower + 2 * threeLower) := by
    calc
      Real.log (10 / 9 : ℝ) /
          (Real.log (10 / 9 : ℝ) + 2 * Real.log (3 : ℝ)) <
          numeratorUpper /
            (Real.log (10 / 9 : ℝ) + 2 * Real.log (3 : ℝ)) :=
        (div_lt_div_iff_of_pos_right hdenActual).2 hn.2
      _ < numeratorUpper / (numeratorLower + 2 * threeLower) := by
        apply (div_lt_div_iff₀ hdenActual hdenLower).2
        nlinarith
  rw [vacancyDelta, log_ten_decomposition]
  constructor
  · have hnumeric :
        AlphaStateLinkBound.deltaLower <
          numeratorLower / (numeratorUpper + 2 * threeUpper) := by
      norm_num [AlphaStateLinkBound.deltaLower, numeratorLower, numeratorUpper,
        threeUpper]
    exact hnumeric.trans hratioLower
  · have hnumeric :
        numeratorUpper / (numeratorLower + 2 * threeLower) <
          AlphaStateLinkBound.deltaUpper := by
      norm_num [AlphaStateLinkBound.deltaUpper, numeratorUpper, numeratorLower,
        threeLower]
    exact hratioUpper.trans hnumeric

theorem stateLink_abs_le_generated_vacancy
    (register : RadixRecovery.K12)
    (haL : AlphaStateLinkBound.aLower < AlphaAnalyticChart.precoordinate register)
    (haU : AlphaAnalyticChart.precoordinate register < AlphaStateLinkBound.aUpper) :
    |AlphaAnalyticChart.stateLink register vacancyDelta| ≤ AlphaAnalyticChart.lambdaBound :=
  AlphaStateLinkBound.stateLink_abs_le register vacancyDelta haL haU
    vacancyDelta_enclosure.1 vacancyDelta_enclosure.2

end VacancyDeltaBounds

